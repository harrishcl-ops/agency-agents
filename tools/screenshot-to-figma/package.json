{
  "name": "screen2figma",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin that turns a UI screenshot into an editable Figma design using Claude vision.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "server": "node dist/server.js",
    "e2e": "bash test/e2e/run-all.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
