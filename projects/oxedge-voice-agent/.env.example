# Copy to .env and fill in. Only the first block is required; everything else is optional.
# Values are read as-is: don't put comments on the same line as a value.

# ---- Required ----
# The https address where this server is reachable (your deploy URL, or an ngrok URL while testing)
PUBLIC_URL=https://layla.example.com
# Any long random string. Vapi sends it with every webhook; generate one with: openssl rand -hex 32
WEBHOOK_SECRET=
# Vapi dashboard > Organization > API Keys (private key)
VAPI_API_KEY=
# Vapi dashboard > Phone Numbers > your number > ID. Needed for inbound calls and for npm run call
VAPI_PHONE_NUMBER_ID=

# ---- Layla ----
# Which assistants to create: en, ar, or en,ar
LANGUAGES=en
# Which language answers inbound calls on the phone number
INBOUND_LANGUAGE=en
LLM_MODEL=claude-haiku-5-5
ELEVENLABS_MODEL=eleven_flash_v2_5
# ElevenLabs voice IDs (copy from the Vapi voice library or your ElevenLabs account)
ELEVENLABS_VOICE_ID_EN=sarah
ELEVENLABS_VOICE_ID_AR=
# A mobile number in +971 format that hot leads are transferred to. Leave empty to offer callbacks instead
TEAM_TRANSFER_NUMBER=

# ---- Discovery-call hours (Dubai time) ----
# 0 = Sunday ... 6 = Saturday
BUSINESS_DAYS=1,2,3,4,5
OPEN_HOUR=10
CLOSE_HOUR=18
SLOT_MINUTES=30
MIN_NOTICE_HOURS=2
DAYS_AHEAD=7

# ---- Google Calendar (optional) ----
# Service account key JSON, raw or base64. Share the calendar with the service account email ("Make changes to events")
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# ---- HubSpot (optional) ----
# Private app token with crm.objects.contacts.read and crm.objects.contacts.write
HUBSPOT_TOKEN=

# ---- WhatsApp Cloud API (optional) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_EN=
WHATSAPP_TEMPLATE_AR=
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Server ----
PORT=3000
DATA_DIR=./data
